                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" onclick="selectGameMode('buzzer')" id="modeBuzzerBtn" class="py-3 px-3 rounded-xl border-2 border-emerald-400 bg-emerald-500/20 text-white font-bold text-sm flex flex-col items-center justify-center gap-1 transition">
                                <i class="fa-solid fa-bolt text-amber-400 text-lg"></i>
                                Rebutan (Buzzer)
                            </button>
                            <button type="button" onclick="selectGameMode('turn')" id="modeTurnBtn" class="py-3 px-3 rounded-xl border-2 border-white/10 bg-slate-800/40 text-slate-400 font-bold text-sm flex flex-col items-center justify-center gap-1 transition">
