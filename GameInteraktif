                    </div>

                    <div class="flex gap-2">
                        <button onclick="addTeamInput()" id="addTeamBtn" class="flex-1 py-2.5 rounded-xl border border-dashed border-white/30 text-slate-300 hover:bg-white/10 hover:text-white transition text-xs font-bold flex items-center justify-center gap-2">
