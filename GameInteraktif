        function usePowerup(type) {
            if (!activeBuzzerTeam) {
                alert("Pilih/Tekan Buzzer tim terlebih dahulu sebelum menggunakan bantuan!");
                return;
            }

            if (!activeBuzzerTeam.powerups[type]) {
                alert("Bantuan ini sudah pernah digunakan oleh tim Anda!");
                return;
            }

            activeBuzzerTeam.powerups[type] = false;
            document.getElementById(`powerup${type.charAt(0).toUpperCase() + type.slice(1)}`).disabled = true;

            if (type === '5050') {
                const q = currentQuestions[currentQIndex];
                let wrongIndices = [0, 1, 2, 3].filter(i => i !== q.correct);
                wrongIndices = wrongIndices.sort(() => 0.5 - Math.random()).slice(0, 2);
                wrongIndices.forEach(i => {
                    const btn = document.getElementById(`optBtn_${i}`);
                    if (btn) btn.classList.add('hidden');
                });
            } else if (type === 'double') {
                activePowerupMultiplier = 2;
                alert(`Powerup Aktif! ${activeBuzzerTeam.name} akan mendapat 2X SKOR jika menjawab benar!`);
            } else if (type === 'time') {
                timeLeft += 15;
                document.getElementById('timerDisplay').innerText = timeLeft;
            }

            renderLeaderboard();
        }

        function checkAnswer(selectedIdx) {
            clearInterval(timerInterval);
            const q = currentQuestions[currentQIndex];
            const isCorrect = selectedIdx === q.correct;

            setOptionsInteractable(false);

            const selectedBtn = document.getElementById(`optBtn_${selectedIdx}`);
            const correctBtn = document.getElementById(`optBtn_${q.correct}`);

            if (isCorrect) {
                playSound('correct');
                if (selectedBtn) selectedBtn.classList.add('bg-emerald-600/60', 'border-emerald-400');
                if (activeBuzzerTeam) {
                    activeBuzzerTeam.score += 100 * activePowerupMultiplier;
                }
            } else {
                playSound('wrong');
                if (selectedBtn) selectedBtn.classList.add('bg-rose-600/60', 'border-rose-400');
                if (correctBtn) correctBtn.classList.add('bg-emerald-600/60', 'border-emerald-400');
                if (activeBuzzerTeam) {
                    activeBuzzerTeam.score = Math.max(0, activeBuzzerTeam.score - 50);
