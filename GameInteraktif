            <button onclick="openShareModal()" class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm shadow-lg shadow-sky-900/40 flex items-center gap-2 btn-3d">
                <i class="fa-solid fa-share-nodes"></i>
                <span class="hidden md:inline">Bagikan Link Siswa</span>
            </button>
            <button onclick="openEditorModal()" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-lg shadow-amber-900/40 flex items-center gap-2 btn-3d">
