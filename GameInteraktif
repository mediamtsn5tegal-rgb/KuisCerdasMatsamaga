            <!-- MAIN GAME GRID: ARENA SOAL & LIVE BAR LEADERBOARD -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- KOLOM KIRI (2 SPAN): KARTU SOAL & BUZZER -->
                <div class="lg:col-span-2 flex flex-col gap-6">
                    
                    <!-- KARTU SOAL UTAMA -->
                    <div class="glass-panel rounded-3xl p-6 md:p-8 flex flex-col justify-between min-h-[420px] relative overflow-hidden border border-emerald-500/30">
                        
                        <!-- DEKORASI BACKGROUND -->
