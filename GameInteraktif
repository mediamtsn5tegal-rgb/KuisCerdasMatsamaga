                            <i class="fa-solid fa-lock text-rose-400 text-2xl mb-1"></i>
                            <h4 class="font-bold text-rose-300 text-sm">Soal Ini Sudah Dikerjakan Kelompok Lain!</h4>
                            <p class="text-xs text-slate-200 mt-0.5">Kelompok Anda tidak bisa lagi menjawab soal ini. Menunggu soal berikutnya...</p>
                        </div>

                        <!-- KOTAK PEMBAHASAN EDUKATIF (Tampil setelah dijawab) -->
                        <div id="explanationBox" class="hidden mt-4 p-4 rounded-2xl bg-slate-900/90 border border-amber-400/40 text-xs md:text-sm text-slate-200 leading-relaxed shadow-lg">
                            <div class="font-bold text-amber-300 mb-1 flex items-center gap-2">
                                <i class="fa-solid fa-book-open"></i> Pembahasan Edukatif IPS:
                            </div>
                            <div id="explanationText">
                                Penjelasan materi kuis akan muncul di sini.
                            </div>
                        </div>

                    </div>

                    <!-- POWER-UP KELOMPOK / BANTUAN -->
                    <div id="powerupContainer" class="glass-panel rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 border border-emerald-500/20">
                        <span class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> Bantuan Tim Aktif:
                        </span>
                        <div class="flex gap-2">
                            <button id="powerup5050" onclick="usePowerup('5050')" class="px-3.5 py-2 rounded-xl bg-indigo-600/40 hover:bg-indigo-600/70 border border-indigo-400/40 text-indigo-200 text-xs font-bold flex items-center gap-1.5 transition btn-3d">
                                <i class="fa-solid fa-scissors"></i> 50:50
                            </button>
                            <button id="powerupDouble" onclick="usePowerup('double')" class="px-3.5 py-2 rounded-xl bg-amber-600/40 hover:bg-amber-600/70 border border-amber-400/40 text-amber-200 text-xs font-bold flex items-center gap-1.5 transition btn-3d">
                                <i class="fa-solid fa-star"></i> 2x Skor
                            </button>
                            <button id="powerupTime" onclick="usePowerup('time')" class="px-3.5 py-2 rounded-xl bg-teal-600/40 hover:bg-teal-600/70 border border-teal-400/40 text-teal-200 text-xs font-bold flex items-center gap-1.5 transition btn-3d">
                                <i class="fa-solid fa-clock-rotate-left"></i> +15 Dtk
                            </button>
                        </div>
                    </div>

                </div>

                <!-- KOLOM KANAN (1 SPAN): PAPAN SKOR LIVE & VISUAL BAR CHART -->
                <div class="glass-panel rounded-3xl p-6 flex flex-col justify-between border border-emerald-500/30">
                    <div>
                        <h3 class="font-fredoka text-xl font-bold text-white mb-4 flex items-center justify-between border-b border-white/10 pb-3">
                            <span><i class="fa-solid fa-trophy text-amber-400 mr-2"></i> Skor Kelompok</span>
                            <span class="text-xs font-sans text-emerald-300 font-semibold">Live MTsN 5</span>
                        </h3>

                        <!-- LIST KARTU SKOR TIM -->
                        <div id="liveLeaderboardList" class="space-y-3.5 mb-6">
                            <!-- Dihasilkan oleh JS -->
                        </div>
                    </div>

                    <!-- VISUAL BAR SKOR COMPARISON -->
                    <div class="bg-slate-900/80 border border-white/10 rounded-2xl p-4">
                        <p class="text-xs font-bold text-emerald-300 mb-3 uppercase tracking-wider text-center">Grafik Poin Real-time</p>
                        <div id="scoreBarsContainer" class="flex items-end justify-around h-32 pt-4 px-2 border-b border-slate-700 gap-2">
                            <!-- Batang grafik dibuat JS -->
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== LAYAR PEMENANG / PODIUM ==================== -->
        <section id="winnerScreen" class="w-full max-w-4xl glass-panel rounded-3xl p-8 md:p-12 text-center hidden my-auto shadow-2xl border border-amber-400/40">
            <div class="mb-6">
                <span class="px-4 py-1.5 bg-amber-400/20 border border-amber-400/40 rounded-full text-amber-300 font-bold text-xs uppercase tracking-widest">
                    🏆 APRESIASI CERDAS CERMAT IPS MTs N 5 TEGAL 🏆
                </span>
                <h2 class="font-fredoka text-3xl md:text-5xl font-bold text-white mt-3">JUARA UTAMA KELOMPOK!</h2>
            </div>

            <!-- PODIUM JUARA (JUARA 2, JUARA 1, JUARA 3) -->
            <div id="podiumContainer" class="flex items-end justify-center gap-3 sm:gap-6 my-10 min-h-[220px]">
                <!-- Generated by JS -->
            </div>

            <!-- STATISTIK PERMAINAN -->
