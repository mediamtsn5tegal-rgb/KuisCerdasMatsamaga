                    <i class="fa-solid fa-flag-checkered mr-2"></i> MULAI ARENA CERDAS CERMAT!
                </button>
            </div>
        </section>

        <!-- ==================== ARENA PERMAINAN (GAMEPLAY) ==================== -->
        <section id="gameplayScreen" class="w-full max-w-6xl hidden flex-col gap-6">

            <!-- HEADER BAR GAMEPLAY: TIMER, ROUND, CATEGORY -->
            <div class="glass-panel rounded-2xl p-4 flex flex-wrap justify-between items-center gap-4 border border-emerald-500/20">
                <div class="flex items-center gap-3">
                    <span id="gameCategoryBadge" class="px-3 py-1 bg-amber-400/20 border border-amber-400/40 rounded-lg text-amber-300 text-xs font-bold uppercase tracking-wide flex items-center gap-1.5">
                        <i class="fa-solid fa-graduation-cap"></i> IPS MTsN 5 Tegal
                    </span>
                    <span id="roundBadge" class="text-white font-fredoka text-lg">
                        Soal <span id="currentQuestionNum" class="text-amber-300">1</span>/<span id="totalQuestionsNum">30</span>
                    </span>
                </div>

                <!-- TIMER DISPLAY -->
                <div id="timerContainer" class="flex items-center gap-3 bg-slate-900/90 border border-amber-400/30 px-5 py-2 rounded-xl shadow-inner">
                    <i class="fa-solid fa-stopwatch text-amber-300 text-xl animate-pulse"></i>
                    <span id="timerDisplay" class="font-fredoka text-2xl font-bold text-amber-300 w-12 text-center">30</span>
                    <span class="text-xs text-slate-400">detik</span>
                </div>

                <!-- STATUS TURN / BUZZER -->
