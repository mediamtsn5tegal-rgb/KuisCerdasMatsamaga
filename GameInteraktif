                        <!-- BUZZER CONTAINER -->
                        <div id="buzzerSection" class="my-3">
                            <p class="text-center text-xs font-bold text-emerald-200/80 mb-2.5 uppercase tracking-wider">Tombol Buzzer Kelompok</p>
                            <div id="buzzerButtonsGrid" class="grid grid-cols-2 md:grid-cols-4 gap-3">
