                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-300 border border-sky-400/40 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-white text-sm">Mode Permainan Online Bersama</h4>
                        <p class="text-xs text-slate-300">Buat room untuk dibagikan ke HP kelompok siswa secara real-time</p>
                    </div>
                </div>
                <div class="flex gap-2 w-full sm:w-auto">
                    <button onclick="initOnlineRoom()" class="flex-1 sm:flex-none px-4 py-2 bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 btn-3d">
                        <i class="fa-solid fa-plus-circle"></i> Buat Room Baru
                    </button>
                    <button onclick="joinOnlineRoomPrompt()" class="flex-1 sm:flex-none px-4 py-2 bg-emerald-500/30 border border-emerald-400/40 hover:bg-emerald-500/50 text-emerald-300 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-right-to-bracket"></i> Gabung PIN Room
