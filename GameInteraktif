                            </div>
                        </div>

                        <!-- PILIHAN JAWABAN (A, B, C, D) -->
                        <div id="optionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-2">
                            <!-- Opsi dibuat dinamis oleh JS -->
                        </div>

                        <!-- BANNER SOAL TERKUNCI (DIKERJAKAN KELOMPOK LAIN) -->
