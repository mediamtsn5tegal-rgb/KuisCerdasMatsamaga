            } else {
                turnBtn.className = 'py-3 px-3 rounded-xl border-2 border-emerald-400 bg-emerald-500/20 text-white font-bold text-sm flex flex-col items-center justify-center gap-1 transition';
                buzzerBtn.className = 'py-3 px-3 rounded-xl border-2 border-white/10 bg-slate-800/40 text-slate-400 font-bold text-sm flex flex-col items-center justify-center gap-1 transition';
            }
        }

        /* -------------------------------------------------------------------------- */
        /* 5. START & GAMEPLAY LOOP                                                   */
        /* -------------------------------------------------------------------------- */
        function startGame() {
            initAudio();

            activeTeams = [];
            for (let i = 0; i < teamCount; i++) {
                const name = document.getElementById(`teamInput_${i}`).value.trim() || TEAM_PRESETS[i].name;
                activeTeams.push({
                    ...TEAM_PRESETS[i],
                    name: name,
                    score: 0,
                    powerups: { '5050': true, 'double': true, 'time': true }
                });
            }

            const cat = document.getElementById('categorySelect').value;
            let bank = [];

            if (cat === 'all') {
                Object.keys(QUESTION_BANKS).forEach(key => {
                    if (key !== 'custom') {
                        bank = bank.concat(QUESTION_BANKS[key]);
                    }
                });
            } else if (QUESTION_BANKS[cat]) {
                bank = QUESTION_BANKS[cat];
            }

            if (cat === 'custom' && QUESTION_BANKS.custom.length === 0) {
                alert("Bank soal kustom masih kosong! Silakan isi melalui tombol 'Kelola Soal'.");
                return;
            }

            currentQuestions = [...bank].sort(() => 0.5 - Math.random());
            totalQuestions = parseInt(document.getElementById('questionCountSelect').value);
            if (currentQuestions.length > totalQuestions) {
                currentQuestions = currentQuestions.slice(0, totalQuestions);
            } else {
                totalQuestions = currentQuestions.length;
            }

            timePerQuestion = parseInt(document.getElementById('timerSelect').value);
            currentQIndex = 0;
            currentTurnIndex = 0;

            // Broadcast Mulai Game ke Kelompok Lain
            if (currentRoomId) {
                window.QuizRelay.send({
                    type: 'START_GAME',
                    teams: activeTeams,
                    questions: currentQuestions,
                    currentQIndex: 0
                });
            }

            document.getElementById('totalQuestionsNum').innerText = totalQuestions;

            document.getElementById('setupScreen').classList.add('hidden');
            document.getElementById('winnerScreen').classList.add('hidden');
            document.getElementById('gameplayScreen').classList.remove('hidden');
            document.getElementById('gameplayScreen').classList.add('flex');

            renderLeaderboard();
            loadQuestion();
        }

        function loadQuestion() {
            clearInterval(timerInterval);
            activeBuzzerTeam = null;
            activePowerupMultiplier = 1;

            document.getElementById('explanationBox').classList.add('hidden');
            document.getElementById('lockedQuestionBanner').classList.add('hidden');

            if (currentQIndex >= totalQuestions) {
                endGame();
                return;
            }

            const q = currentQuestions[currentQIndex];

            document.getElementById('currentQuestionNum').innerText = currentQIndex + 1;
            document.getElementById('questionText').innerText = q.q;
            document.getElementById('subTopicTag').innerText = q.subTopic || 'IPS MTs';
            document.getElementById('questionIconBadge').innerHTML = `<i class="fa-solid ${q.icon || 'fa-graduation-cap'}"></i>`;

            document.getElementById('powerup5050').disabled = false;
            document.getElementById('powerupDouble').disabled = false;
            document.getElementById('powerupTime').disabled = false;

            renderOptions(q.opts, q.correct);

            if (gameMode === 'buzzer') {
                document.getElementById('buzzerSection').classList.remove('hidden');
                document.getElementById('activeTeamStatusText').innerText = 'Rebutan! Tekan Bel Kelompok...';
                document.getElementById('activeTeamStatusText').className = 'text-amber-300 font-bold';
                document.getElementById('activeTeamIndicatorDot').className = 'w-3 h-3 rounded-full bg-amber-400 animate-ping';
                renderBuzzerButtons(true);
                setOptionsInteractable(false);
            } else {
                document.getElementById('buzzerSection').classList.add('hidden');
                activeBuzzerTeam = activeTeams[currentTurnIndex];
                updateActiveTeamStatusText(`Giliran Jawab: ${activeBuzzerTeam.name}`, activeBuzzerTeam);
                setOptionsInteractable(true);
            }

            if (timePerQuestion > 0) {
                timeLeft = timePerQuestion;
                document.getElementById('timerContainer').classList.remove('hidden');
                document.getElementById('timerDisplay').innerText = timeLeft;
                timerInterval = setInterval(handleTimer, 1000);
            } else {
                document.getElementById('timerContainer').classList.add('hidden');
            }
        }

        function pressBuzzer(teamId) {
            if (activeBuzzerTeam !== null) return;

            activeBuzzerTeam = activeTeams.find(t => t.id === teamId);
            playSound('buzzer');

            // Kunci Soal secara Realtime agar kelompok lain tidak bisa menjawab
            if (currentRoomId) {
                window.QuizRelay.send({
                    type: 'LOCK_QUESTION',
                    teamId: teamId
                });
            }

            updateActiveTeamStatusText(`Diambil Oleh: ${activeBuzzerTeam.name}!`, activeBuzzerTeam);
            renderBuzzerButtons(false);
            setOptionsInteractable(true);
        }

        function nextQuestion() {
            currentQIndex++;
            if (gameMode === 'turn') {
                currentTurnIndex = (currentTurnIndex + 1) % activeTeams.length;
            }

            // Sync Soal Berikutnya
            if (currentRoomId) {
                window.QuizRelay.send({
                    type: 'NEXT_QUESTION',
                    currentQIndex: currentQIndex
                });
            }

            loadQuestion();
        }

        window.onload = function() {
            renderTeamInputs();
            checkUrlForRoomPin();
        }
    </script>
</body>
</html>
