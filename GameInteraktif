                currentRoomId = pin;

                // Inisialisasi Relay Lokal & Broadcast
                window.QuizRelay.init(currentRoomId);

                document.getElementById('activeRoomBadge').classList.remove('hidden');
                document.getElementById('roomPinText').innerText = currentRoomId;
                document.getElementById('modalPinText').innerText = currentRoomId;
                
                const currentUrl = window.location.href.split('?')[0].split('#')[0];
                document.getElementById('shareUrlInput').value = `${currentUrl}#room=${currentRoomId}`;

                openShareModal();
            } catch(e) {
                console.warn("Room Init Fallback:", e);
            }
        }

        function checkUrlForRoomPin() {
            const hash = window.location.hash;
            if (hash && hash.includes('room=')) {
                const pin = hash.split('room=')[1].split('&')[0];
                if (pin) {
                    joinRoomById(pin);
                }
            }
        }

        async function joinRoomById(pin) {
            currentRoomId = pin;
            window.QuizRelay.init(currentRoomId);

            document.getElementById('activeRoomBadge').classList.remove('hidden');
            document.getElementById('roomPinText').innerText = currentRoomId;
            
            // Beritahu kelompok lain
            window.QuizRelay.send({ type: 'JOIN_ROOM', roomId: pin });
            alert(`Berhasil terhubung ke Kelompok Room PIN: ${currentRoomId}!`);
        }

        // Menerima pesan real-time antar tab/HP
        window.handleRelayMessage = function(data) {
            if (!data) return;

            if (data.type === 'START_GAME') {
                syncStartGameFromRemote(data);
            } else if (data.type === 'LOCK_QUESTION') {
                handleRemoteQuestionLocked(data.teamId);
            } else if (data.type === 'NEXT_QUESTION') {
                currentQIndex = data.currentQIndex;
                loadQuestion();
            }
        };

