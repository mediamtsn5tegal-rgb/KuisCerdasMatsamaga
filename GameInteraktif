                                <span id="subTopicTag" class="px-3 py-1 bg-sky-500/20 text-sky-300 rounded-md text-xs font-bold border border-sky-400/30">
                                    Sub-Materi IPS
                                </span>
                                <span id="questionIconBadge" class="w-12 h-12 rounded-2xl bg-slate-800/80 border border-white/20 flex items-center justify-center text-2xl text-amber-300 shadow-inner">
                                    <i class="fa-solid fa-question"></i>
                                </span>
                            </div>

                            <!-- TEXT SOAL -->
                            <h3 id="questionText" class="font-fredoka text-xl md:text-2xl font-bold text-white leading-relaxed mb-6">
                                Memuat Pertanyaan...
