<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cerdas Cermat Arena IPS - MTs N 5 Tegal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Standalone Multi-Device & Broadcast Relay System (No Permission Error) -->
    <script>
        // Channel Komunikasi Realtime Bebas Kendala Permission
        window.QuizRelay = {
            channel: null,
            init(roomId) {
                try {
                    this.channel = new BroadcastChannel('mtsn5_quiz_' + roomId);
                    this.channel.onmessage = (event) => {
                        if (window.handleRelayMessage) {
                            window.handleRelayMessage(event.data);
                        }
                    };
                } catch(e) {
                    console.log("BroadcastChannel active fallback");
                }
            },
            send(data) {
                if (this.channel) {
                    try { this.channel.postMessage(data); } catch(e){}
                }
            }
        };
    </script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            gold: '#FFD700',
                            emerald: '#059669',
                            blue: '#0284C7',
                            red: '#EF4444',
                            purple: '#8B5CF6',
                            dark: '#0F172A'
                        }
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%, 100%': { transform: 'scale(1)', boxShadow: '0 0 15px rgba(255,215,0,0.4)' },
                            '50%': { transform: 'scale(1.03)', boxShadow: '0 0 30px rgba(255,215,0,0.8)' },
                        },
                        bounceShort: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-8px)' }
                        }
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 1.5s infinite ease-in-out',
                        'bounce-short': 'bounceShort 1.2s infinite ease-in-out'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #064e3b 0%, #0f172a 50%, #1e1b4b 100%);
            min-height: 100vh;
            color: #f8fafc;
            user-select: none;
